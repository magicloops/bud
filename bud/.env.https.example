# Optional local HTTPS parity profile.
# Copy this file to bud/.env when testing through Caddy. The default
# bud/.env.example remains the recommended no-Caddy HTTP quickstart.

BUD_SERVER_URL=wss://localhost:3443/ws
BUD_DEVICE_NAME=bud-dev
BUD_TERMINAL_ENABLED=true
# Browser support is an opt-in add-on (Phase 3r). Prepare it once from the
# checkout instead of pointing the daemon at a browser through the environment:
#   cargo run -- browser prepare --helper-dir bud/browser-helper --node "$(which node)"
# The daemon then reads ~/.bud/browser/manifest.json. Setting BUD_BROWSER_EXECUTABLE
# alone makes the browser unavailable: an override needs BUD_BROWSER_HELPER too.
#BUD_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
#BUD_BROWSER_HELPER="/Users/adam/bud/bud/browser-helper/main.mjs"
BUD_BROWSER_HEADED=1
# BUD_CLAIM_ID=

# Optional Bud-local ds4 forwarding. The daemon must already be running beside
# a ds4 server; Bud only probes and forwards the allowlisted API path.
# BUD_LOCAL_LLM_DS4_URL=http://127.0.0.1:8000
# BUD_LOCAL_LLM_DS4_CONTEXT_TOKENS=100000
# BUD_LOCAL_LLM_DS4_MAX_OUTPUT_TOKENS=384000

# Optional local state overrides:
# BUD_BASE_DIR=$HOME/.bud
# BUD_LOCAL=false
# BUD_DEFAULT_CWD=$HOME
# BUD_IDENTITY_FILE=$HOME/.bud/identity.json
# BUD_TERMINAL_BASE_DIR=$HOME/.bud
# BUD_DEBUG=false
